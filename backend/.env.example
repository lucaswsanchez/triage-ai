# LLM provider (any OpenAI-compatible API). Leave LLM_API_KEY empty to run in demo mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_MAX_TOKENS=700
# Provider-specific JSON body (DeepSeek: disable thinking mode). Use {} for other providers.
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# Cost protection
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=3600
MAX_TICKET_CHARS=4000
# Global cap of live LLM calls per UTC day (all users)
DAILY_LLM_BUDGET=300

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
